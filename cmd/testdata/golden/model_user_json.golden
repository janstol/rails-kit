{
  "schema_version": 1,
  "command": "model",
  "data": {
    "class_name": "User",
    "parent_class": "ApplicationRecord",
    "rel_path": "app/models/user.rb",
    "concerns": [
      "Searchable",
      "Auditable"
    ],
    "associations": [
      "has_many :posts, dependent: destroy",
      "has_many :comments, dependent: destroy",
      "has_many :published_posts, through: posts, class_name: Post"
    ],
    "validations": [
      "validates :email, presence, uniqueness, format",
      "validates :name, presence, length",
      "validate :email_not_banned (custom)"
    ],
    "scopes": [
      "active",
      "admins",
      "by_name(name)"
    ],
    "callbacks": [
      "before_validation :normalize_email",
      "after_create_commit :notify_admin",
      "after_save :invalidate_cache",
      "after_commit :sync_to_search_index",
      "after_touch :update_counter_cache"
    ],
    "enums": [
      "role"
    ],
    "delegates": [
      "delegate :title, :body, to: :latest_post, prefix: true, allow_nil: true"
    ]
  }
}
