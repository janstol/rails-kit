{
  "schema_version": 1,
  "command": "helpers",
  "data": {
    "class_name": "UsersHelper",
    "kind": "module",
    "rel_path": "app/helpers/users_helper.rb",
    "concerns": [
      "IconHelper"
    ],
    "constants": [
      "DEFAULT_AVATAR_SIZE = 40"
    ],
    "methods": [
      "user_avatar(user)",
      "user_badge(user, size = DEFAULT_AVATAR_SIZE)",
      "user_status_tag(user:, css_class: \"status\")",
      "user_tags(*tags)",
      "with_user_context(\u0026block)",
      "current_user_name",
      "user_summary(user, show_email: false, show_role: false)",
      "default_avatar_url",
      "default_role_label",
      "internal_role_key"
    ]
  }
}
