UsersController < ApplicationController (app/controllers/users_controller.rb)
========================================

Layout:
  "users"

Filters:
  before_action :authenticate_user!
  before_action :set_user, only: [:show, :edit, :update, :destroy]
  skip_before_action :authenticate_user!, only: [:index], if: :public_action?
  after_action :log_action
  around_action :measure_time

Rescue From:
  rescue_from ActiveRecord::RecordNotFound, ActiveRecord::RecordInvalid, with: :handle_not_found
  rescue_from StandardError (block)

Helper Methods:
  user_display_name

Respond To:
  html
  json

Strong Params:
  user_params: params.require(:user).permit(:name, :email, tags: [])

Actions:
  index
  show
  create
  update
  destroy

